# Copy to .env (gitignored) and fill in. Token: Discord Developer Portal › your application › Bot › Reset Token.
INSPECT_BOT_TOKEN=
# Optional: the server's ID (right-click the server › Copy Server ID, Developer Mode on). Blank = the only server it's in.
GUILD_ID=
REPORT_CHANNEL=bot-report
BLOXLINK_API_KEY=
WEEKLY_REPORT=on  # "off" stops the Monday report; /inspect still works
